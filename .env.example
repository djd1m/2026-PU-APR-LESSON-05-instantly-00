# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/instantly

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI (for AI personalization)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=30.0
OPENAI_MAX_RETRIES=3

# Mailivery (for email warmup — optional)
MAILIVERY_API_KEY=
MAILIVERY_BASE_URL=https://app.mailivery.io/api/v1

# Email sending settings
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_WAIT_SECONDS=2.0

# App settings
APP_NAME=Instantly.ai API
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
